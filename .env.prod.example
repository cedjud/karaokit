# Copy to .env on the server (compose.prod.yaml).
APP_DOMAIN=karaokit.example.com
API_DOMAIN=api.example.com
# R2 custom domain for the bucket (Cloudflare dashboard > bucket > Settings > Custom Domains).
MEDIA_DOMAIN=media.example.com
OPENAI_API_KEY=
# Long random string, e.g. openssl rand -hex 32. Baked into the web bundle as VITE_API_TOKEN.
API_TOKEN=

# R2 > Manage API tokens > Object Read & Write, scoped to the bucket.
R2_ACCOUNT_ID=
R2_BUCKET=music-wheel
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
